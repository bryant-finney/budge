# The backend builds from the repository root so Git can inspect the complete source tree.
# Git history is supplied separately through a read-only named build context.
**/.git
# Only the root entry stays, emptied: in a linked worktree it's the file naming that worktree's Git directory.
!.git
.git/*
.claude/worktrees/

# Local environments, credentials and caches never belong in an image.
**/.env*
!**/.envrc
**/.venv/
**/.direnv/
**/.aws/
**/node_modules/
**/.svelte-kit/
**/.pulumi/
**/.cache/
**/reports/
**/.coverage*
**/htmlcov/
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/
**/__pycache__/
**/*.pyc
**/dist/
src/back-end/budge/_version.py
