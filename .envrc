#!/usr/bin/env bash

# seed .env from the template on first use
test -f ./.env || cp etc/base.env ./.env

if type watch_file >/dev/null 2>&1; then
	watch_file pyproject.toml "$(git rev-parse --git-path HEAD)" \
		"$(git rev-parse --git-common-dir)/packed-refs" "$(git rev-parse --git-common-dir)/refs/tags"
	budge_branch="$(git symbolic-ref --quiet HEAD)" && watch_file "$(git rev-parse --git-path "$budge_branch")"
	unset budge_branch
fi

budge_version="$(uv tool run --from uv-dynamic-versioning==0.14.0 uv-dynamic-versioning)" || return

# budge.__version__ is the source of truth, and the image builds read it. Only the back end's hatch version hook writes
# it; the check matches the hook's template in src/back-end/pyproject.toml, so change the two together.
if ! grep -Fqs "__version__ = '$budge_version'" src/back-end/budge/_version.py; then
	uvx --directory src/back-end hatch -q build --hooks-only -t sdist >/dev/null || return
fi

# Dev mode is the local default for a .env that predates it; any COMPOSE_FILE already there stays.
grep -q '^COMPOSE_FILE=' .env || echo 'COMPOSE_FILE=compose.yaml:etc/compose/targets/dev.yaml' >>.env

# Replace only the generated line, so local credentials and other settings survive. OCI tags can't contain `+`, so the
# image tag drops the local segment.
(
	umask 077
	{
		grep -v '^BUDGE_VERSION=' .env
		printf "BUDGE_VERSION='%s'\n" "${budge_version%%+*}"
	} >.env.generated
) || return
if cmp -s .env .env.generated; then rm .env.generated; else mv .env.generated .env; fi
unset budge_version

# Use direnv's parser when available; otherwise support plain Bash sourcing.
if type dotenv_if_exists >/dev/null 2>&1; then
	dotenv_if_exists .env
else
	set -a
	# shellcheck disable=SC1091  # .env is local configuration, seeded above.
	source .env
	set +a
fi
