#!/usr/bin/env bash

# seed .env from the template on first use
test -f ./.env || cp etc/base.env ./.env

if type watch_file >/dev/null 2>&1; then
	watch_file pyproject.toml "$(git rev-parse --git-path HEAD)" \
		"$(git rev-parse --git-common-dir)/packed-refs" "$(git rev-parse --git-common-dir)/refs/tags"
	budge_branch="$(git symbolic-ref --quiet HEAD)" && watch_file "$(git rev-parse --git-path "$budge_branch")"
	unset budge_branch
fi

# Refresh only generated values; retain local credentials and Compose settings.
budge_version="$(uv tool run --from uv-dynamic-versioning==0.14.0 uv-dynamic-versioning)" || return
python3 - "$budge_version" <<'PY' || return
import os
from pathlib import Path
import subprocess
import sys

root = Path.cwd().resolve()
values = {
    'BUDGE_VERSION': sys.argv[1],
    'BUDGE_IMAGE_TAG': sys.argv[1].replace('+', '-'),
    'BUDGE_REPO_ROOT': str(root),
    'BUDGE_GIT_COMMON_DIR': subprocess.check_output(
        ['git', 'rev-parse', '--path-format=absolute', '--git-common-dir'], text=True
    ).strip(),
}
path = root / '.env'
lines = [line for line in path.read_text().splitlines() if line.split('=', 1)[0] not in values]
if not any(line.startswith('COMPOSE_FILE=') for line in lines):
    lines.append('COMPOSE_FILE=compose.yaml:etc/compose/dev.yaml')
lines.extend(f'{key}={value!r}' for key, value in values.items())
content = '\n'.join(lines) + '\n'
if path.read_text() != content:
    temporary = path.with_name('.env.generated')
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, 'w') as output:
        output.write(content)
    temporary.replace(path)
PY
unset budge_version

# Use direnv's parser when available; otherwise support plain Bash sourcing.
if type dotenv_if_exists >/dev/null 2>&1; then
	dotenv_if_exists .env
else
	set -a
	# shellcheck disable=SC1091  # .env is local configuration, seeded above.
	source .env
	set +a
fi
