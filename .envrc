#!/usr/bin/env bash

# seed .env from the template on first use
test -f ./.env || cp etc/base.env ./.env

# Use direnv's parser when available; otherwise support plain Bash sourcing.
if type dotenv_if_exists >/dev/null 2>&1; then
	dotenv_if_exists .env
else
	set -a
	# export variables from .env (if it exists)
	# shellcheck disable=SC2046  # cannot surround with quotes: breaks export command
	! test -f ./.env || export $(grep -oE '^[^ #]{1,}=[^#]{1,}' .env | xargs)
	set +a
fi

if type PATH_add >/dev/null 2>&1; then
	PATH_add bin
else
	export PATH="$PWD/bin:$PATH"
fi
