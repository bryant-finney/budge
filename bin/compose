#!/usr/bin/env bash
set -euo pipefail

repo_root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
export BUDGE_REPO_ROOT="$repo_root"
export BUDGE_GIT_COMMON_DIR
BUDGE_GIT_COMMON_DIR="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)"
export BUDGE_VERSION
BUDGE_VERSION="$(uv run --quiet --directory "$repo_root/src/back-end" --locked python -c 'import budge; print(budge.__version__)')"
export BUDGE_IMAGE_TAG="${BUDGE_VERSION//+/-}"

compose_args=(--project-directory "$repo_root" --env-file "$repo_root/etc/base.env")
if [[ -f "$repo_root/.env" ]]; then
	compose_args+=(--env-file "$repo_root/.env")
fi
compose_args+=(-f "$repo_root/compose.yaml" -f "$repo_root/etc/compose/dev.yaml")
exec "${CONTAINER_ENGINE:-docker}" compose "${compose_args[@]}" "$@"
