# template for .env (copied by .envrc on first use); replace the placeholders.
# never put local endpoint overrides (AWS_ENDPOINT_URL_*) here: they belong in
# docker compose, or they leak into `aws` and `pulumi up` run from this shell.

# Plaid Sandbox API credentials (Plaid Dashboard → Developers → Keys)
PLAID_CLIENT_ID=000000000000000000000000
PLAID_CLIENT_SECRET=000000000000000000000000000000
PLAID_ENV=sandbox

# AWS + Pulumi (state lives in S3; see src/infrastructure/bootstrap.sh)
AWS_PROFILE=budge
PULUMI_BACKEND_URL=s3://budge-pulumi-state-000000000000?region=us-east-1

# Local containers only; bin/compose derives image tags from budge.__version__.
BUDGE_IMAGE_PREFIX=ghcr.io/bryant-finney
BUDGE_PLATFORM=linux/arm64
BUDGE_BIND_HOST=127.0.0.1
BUDGE_API_PORT=8000
BUDGE_INGESTION_PORT=9002
# Only Compose maps this to the SDK's AWS_ENDPOINT_URL_S3, inside containers.
BUDGE_S3_ENDPOINT=http://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Deliberately public development credentials; never use them outside the local stack.
MINIO_ROOT_USER=budge-local
MINIO_ROOT_PASSWORD=budge-local-password
AWS_REGION=us-east-1
# Bump the release label and immutable upstream source commit together.
MINIO_RELEASE=RELEASE.2025-10-15T17-29-55Z
MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
