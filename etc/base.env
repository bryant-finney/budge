# template for .env (copied by .envrc on first use); replace the placeholders.
# never put local endpoint overrides (AWS_ENDPOINT_URL_*) here: they belong in
# docker compose, or they leak into `aws` and `pulumi up` run from this shell.

# Plaid Sandbox API credentials (Plaid Dashboard → Developers → Keys)
PLAID_CLIENT_ID=000000000000000000000000
PLAID_CLIENT_SECRET=000000000000000000000000000000
PLAID_ENV=sandbox

# AWS + Pulumi (state lives in S3; see src/infrastructure/bootstrap.sh)
AWS_PROFILE=budge
PULUMI_BACKEND_URL=s3://budge-pulumi-state-000000000000?region=us-east-1

# Local containers only; .envrc refreshes BUDGE_VERSION, BUDGE_IMAGE_VERSION and checkout paths.
# Compose names each stack after its checkout directory; set COMPOSE_PROJECT_NAME to override.
COMPOSE_FILE=compose.yaml:etc/compose/dev.yaml
# The values below are the defaults in compose.yaml and etc/compose/; uncomment one to override it.
# The target applies to both the api and ingestion services, which share one image per target.
# BUDGE_BUILD_TARGET=dev
# BUDGE_IMAGE_PREFIX=ghcr.io/bryant-finney
# BUDGE_PLATFORM=linux/arm64
# Compose splits these into words. The api defaults depend on the target: see etc/compose/targets/. These are for dev.
# BUDGE_API_COMMAND='uvicorn budge.api.app:app --host 0.0.0.0 --port 8080'
# BUDGE_API_ENTRYPOINT=''
# On rel, the api defaults are instead:
# BUDGE_API_COMMAND=budge.api.handler.handler
# BUDGE_API_ENTRYPOINT=/lambda-entrypoint.sh
# BUDGE_INGESTION_COMMAND=budge.ingestion.handler.handler
# BUDGE_INGESTION_ENTRYPOINT=/lambda-entrypoint.sh
# Host bindings apply only when etc/compose/ports.yaml is included in COMPOSE_FILE.
# BUDGE_BIND_HOST=127.0.0.1
# BUDGE_API_PORT=8000
# BUDGE_INGESTION_PORT=9002
# Only Compose maps this to the SDK's AWS_ENDPOINT_URL_S3, inside containers.
# BUDGE_S3_ENDPOINT=http://minio:9000
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# Deliberately public development credentials; never use them outside the local stack.
# MINIO_ROOT_USER=budge-local
# MINIO_ROOT_PASSWORD=budge-local-password
# AWS_REGION=us-east-1
# Override the release label and immutable upstream source commit together.
# MINIO_RELEASE=RELEASE.2025-10-15T17-29-55Z
# MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
