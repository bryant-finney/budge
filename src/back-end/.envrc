#!/usr/bin/env bash

# direnv only loads the closest .envrc; inherit the repository-level environment
if type source_up_if_exists >/dev/null 2>&1; then
	source_up_if_exists
	# re-sync when the dependency set changes
	watch_file pyproject.toml uv.lock
fi

# create or update the package's virtual environment, then activate it
uv sync --locked --all-groups

# shellcheck disable=SC1091  # created by uv sync
. .venv/bin/activate
