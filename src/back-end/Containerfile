# syntax=docker/dockerfile:1

# compose.yaml supplies the repository and read-only Git contexts for both targets.

FROM docker.io/astral/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

# The newest generally available Lambda Python runtime (`python3.15` is Lambda preview-only), pinned by tag and by the
# multi-platform index digest, so `--platform` still selects the `linux/arm64` image. Bump both together.
FROM public.ecr.aws/lambda/python:3.14@sha256:fc4e15a5e09e2c9b6184810ea0fdc87afe1c1c734c98cbe27d739a35c3f15e7e AS base

FROM base AS dependencies

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_INSTALLER_METADATA=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/budge

# Use a standard venv without uv's _virtualenv.pth bootstrap: only its installed packages are copied into rel.
RUN python3 -m venv --without-pip /opt/budge
WORKDIR /build
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=src/back-end/pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=src/back-end/uv.lock,target=uv.lock \
    uv sync --frozen --no-dev --no-install-project

FROM dependencies AS build

RUN microdnf install -y git-core-2.50.1-1.amzn2023.0.1 && microdnf clean all
WORKDIR /workspace/src/back-end
# In a linked worktree, `.git` is a file naming the worktree's directory under the common Git directory. Elsewhere it's
# an empty directory that sed can't read, which leaves GIT_DIR at the common directory itself.
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,target=/workspace,rw \
    --mount=type=bind,from=git-common,target=/git \
    GIT_DIR="/git$(sed -n 's|^gitdir: .*\(/worktrees/.*\)|\1|p' /workspace/.git 2>/dev/null)" \
    GIT_WORK_TREE=/workspace uv build --wheel --out-dir /dist \
    && uv pip install --python /opt/budge/bin/python --no-deps /dist/*.whl \
    && site_packages="$(/opt/budge/bin/python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')" \
    && cp -a "${site_packages}/." "${LAMBDA_TASK_ROOT}/"

FROM dependencies AS dev

RUN microdnf install -y git-core-2.50.1-1.amzn2023.0.1 nodejs24-24.20.0-1.amzn2023.0.1 \
    && microdnf clean all
COPY --from=uv /uv /uvx /usr/local/bin/
COPY --exclude=.git . /workspace/
WORKDIR /workspace/src/back-end
# Editable, so the checkout that etc/compose/targets/dev.yaml mounts at /workspace replaces the installed source.
RUN --mount=type=bind,source=.git,target=/workspace/.git \
    --mount=type=bind,from=git-common,target=/git \
    uv sync --frozen --all-groups --no-install-project \
    && GIT_DIR="/git$(sed -n 's|^gitdir: .*\(/worktrees/.*\)|\1|p' /workspace/.git 2>/dev/null)" \
    GIT_WORK_TREE=/workspace uv pip install --python /opt/budge/bin/python --no-deps --editable . \
    && ln -s /opt/budge .venv \
    && ln -s "$(/opt/budge/bin/python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')" /opt/budge/site-packages
# The Lambda runtime uses the system Python, so point it at the source tree and the virtual environment's packages.
ENV LAMBDA_TASK_ROOT=/workspace/src/back-end \
    PATH="/opt/budge/bin:${PATH}" \
    PYTHONPATH=/opt/budge/site-packages
ENTRYPOINT []
CMD ["/bin/bash"]

FROM base AS rel

COPY --from=build ${LAMBDA_TASK_ROOT} ${LAMBDA_TASK_ROOT}

CMD ["budge.ingestion.handler.handler"]
