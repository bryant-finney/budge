# syntax=docker/dockerfile:1

# The build context is src/back-end. Neither image uses Git: the host computes the version.

FROM docker.io/astral/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

# The newest generally available Lambda Python runtime (`python3.15` is Lambda preview-only), pinned by tag and by the
# multi-platform index digest, so `--platform` still selects the `linux/arm64` image. Bump both together.
FROM public.ecr.aws/lambda/python:3.14@sha256:fc4e15a5e09e2c9b6184810ea0fdc87afe1c1c734c98cbe27d739a35c3f15e7e AS base

FROM base AS dependencies

# Everything installs into the system Python. Its packages include the Lambda runtime's awslambdaric, which uv.lock
# doesn't list, so `uv sync` needs --inexact or it uninstalls them. Stages built from this one inherit these ARGs, which
# stay out of the rel image's config.
ARG UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_INSTALLER_METADATA=1 \
    UV_PROJECT_ENVIRONMENT=/var/lang \
    UV_PYTHON_DOWNLOADS=never
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    uv sync --frozen --inexact --no-dev --no-install-project

FROM dependencies AS build

# compose.yaml passes the version that the host's .envrc computed. Without it, rel reports the 0.0.0 fallback.
ARG UV_DYNAMIC_VERSIONING_BYPASS
COPY . ${LAMBDA_TASK_ROOT}/
# Editable, so the system Python holds the metadata and the code stays in one place, the task root.
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /var/lang/bin/python --no-deps --editable . \
    && python3 -m compileall -q budge

FROM dependencies AS dev

RUN microdnf install -y nodejs24-24.20.0-1.amzn2023.0.1 && microdnf clean all
COPY . ${LAMBDA_TASK_ROOT}/
# Editable, so the source that etc/compose/targets/dev.yaml mounts over the task root replaces the installed copy.
# This stage doesn't take the host's version and has no Git, so the version is the 0.0.0 fallback.
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --inexact --all-groups
ENTRYPOINT []
CMD ["uvicorn", "budge.api.app:app", "--host", "0.0.0.0", "--port", "8080", "--reload"]

FROM dependencies AS rel

# Only the package: the tests, uv.lock and the other development files stop at the build stage.
COPY --from=build ${LAMBDA_TASK_ROOT}/budge ${LAMBDA_TASK_ROOT}/budge
COPY --from=build --parents /var/lang/lib/python3.*/site-packages/*budge* /

CMD ["budge.api.handler.handler"]
