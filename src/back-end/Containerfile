# syntax=docker/dockerfile:1

# compose.yaml configures both targets; .envrc supplies the tag-derived package version.

FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

# The newest generally available Lambda Python runtime (`python3.15` is Lambda preview-only), pinned by tag and by the
# multi-platform index digest, so `--platform` still selects the `linux/arm64` image. Bump both together.
FROM public.ecr.aws/lambda/python:3.14@sha256:fc4e15a5e09e2c9b6184810ea0fdc87afe1c1c734c98cbe27d739a35c3f15e7e AS base

FROM base AS dependencies

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_INSTALLER_METADATA=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/budge

# Use a standard venv without uv's _virtualenv.pth bootstrap: only its installed packages are copied into rel.
RUN python3 -m venv --without-pip /opt/budge
WORKDIR /build
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    uv sync --frozen --no-dev --no-install-project

FROM dependencies AS build

ARG BUDGE_VERSION=0.0.0
COPY pyproject.toml uv.lock ./
COPY budge/ ./budge/
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    UV_DYNAMIC_VERSIONING_BYPASS="${BUDGE_VERSION}" uv build --wheel --out-dir /dist \
    && uv pip install --python /opt/budge/bin/python --no-deps /dist/*.whl \
    && site_packages="$(/opt/budge/bin/python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')" \
    && cp -a "${site_packages}/." "${LAMBDA_TASK_ROOT}/"

FROM dependencies AS dev

RUN microdnf install -y git-core-2.50.1-1.amzn2023.0.1 nodejs24-24.20.0-1.amzn2023.0.1 \
    && microdnf clean all
COPY --from=uv /uv /uvx /usr/local/bin/
WORKDIR /workspace/src/back-end
COPY . ./
ARG BUDGE_VERSION=0.0.0
RUN UV_DYNAMIC_VERSIONING_BYPASS="${BUDGE_VERSION}" uv sync --frozen --all-groups && ln -s /opt/budge .venv
ENV PATH="/opt/budge/bin:${PATH}"
ENTRYPOINT []
CMD ["/bin/bash"]

FROM base AS rel

COPY --from=build ${LAMBDA_TASK_ROOT} ${LAMBDA_TASK_ROOT}

CMD ["budge.ingestion.handler.handler"]
