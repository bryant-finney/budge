#!/usr/bin/env bash

# direnv only loads the closest .envrc; inherit the repository-level environment
if type source_up_if_exists >/dev/null 2>&1; then
	source_up_if_exists
	# re-sync when the dependency set changes
	watch_file package.json ../../package.json ../../pnpm-lock.yaml ../../pnpm-workspace.yaml
fi

# install the package's dependencies from the workspace lockfile
pnpm install --frozen-lockfile
