{
  "name": "front-end",
  "private": true,
  "description": "budge's single-page app (SvelteKit + TypeScript)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#lib": "./lib/index.ts",
    "#lib/*": "./lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.7",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "^8.3.5"
  }
}
