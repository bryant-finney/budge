{
  "extends": [
    "$app/tsconfig",
    "../../tsconfig.base.json"
  ],
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true
  },
  "include": [
    "*.ts",
    "lib",
    "routes"
  ],
  "exclude": [
    "service-worker"
  ]
}
